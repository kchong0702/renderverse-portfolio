{
  "name": "artifact-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/artifact-service/src",
  "tags": ["type:app", "scope:backend"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run python -m src.main",
        "cwd": "apps/artifact-service"
      },
      "dependsOn": [
        {
          "projects": ["document-renderer"],
          "target": "build"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/artifact-service"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format .",
        "cwd": "apps/artifact-service"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "apps/artifact-service"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run pyright",
        "cwd": "apps/artifact-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/artifact-service"
      },
      "dependsOn": [
        {
          "projects": ["document-renderer"],
          "target": "build"
        }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build artifact-service"
      }
    }
  }
}
