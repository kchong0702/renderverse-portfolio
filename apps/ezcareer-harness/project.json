{
  "name": "ezcareer-harness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ezcareer-harness/src",
  "tags": ["type:app", "scope:backend"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"const fs=require('fs'); if (!fs.existsSync('.env')) fs.copyFileSync('.env.example','.env')\"",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run python -m src.main",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format .",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run pyright",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "uv",
        "{workspaceRoot}/apps/ops-api/tests/features/jobs/fixtures/job_search_answer.json"
      ],
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/ezcareer-harness"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build ezcareer-harness"
      }
    }
  }
}
