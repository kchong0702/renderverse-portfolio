# ---------------- DATABASE ------------------
OPS_API_DATABASE__URL=postgresql+asyncpg://ops:ops@localhost:5432/ops

# ---------------- AUTH ------------------
OPS_API_AUTH__ALLOWED_EMAILS=
OPS_API_AUTH__SECRET_KEY=

OPS_API_AUTH__GOOGLE__CLIENT_ID=
OPS_API_AUTH__GOOGLE__CLIENT_SECRET=

OPS_API_AUTH__GITHUB__CLIENT_ID=
OPS_API_AUTH__GITHUB__CLIENT_SECRET=

# ---------------- JSEARCH (each user's own API key) ------------------
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPS_API_JSEARCH__ENCRYPTION_KEY=

# ---------------- GOOGLE (read and send Gmail, read Calendar and add events) ------------------
# OAuth client (web application) with the redirect URI google.redirect_uri,
# by default http://localhost:5174/ops-api/v1/integrations/google/callback
OPS_API_GOOGLE__CLIENT_ID=
OPS_API_GOOGLE__CLIENT_SECRET=
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPS_API_GOOGLE__ENCRYPTION_KEY=
# Optional: the Gmail search Inbox lists, e.g. label:job-search
# OPS_API_GOOGLE__INBOX_QUERY=
