{
  "name": "ezbot-harness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ezbot-harness/src",
  "tags": ["type:app", "scope:backend"],
  "targets": {
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"const fs=require('fs'); if (!fs.existsSync('.env')) fs.copyFileSync('.env.example','.env')\"",
        "cwd": "apps/ezbot-harness"
      }
    },
    "laya": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d laya"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run python -m src.main",
        "cwd": "apps/ezbot-harness"
      },
      "dependsOn": ["laya"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/ezbot-harness"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format .",
        "cwd": "apps/ezbot-harness"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "apps/ezbot-harness"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/ezbot-harness"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build laya ezbot"
      }
    }
  }
}
