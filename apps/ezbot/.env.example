# ---------------- OBSERVABILITY ------------------
# The collector runs from the root docker-compose.yaml (ports in the root .env)
EZBOT_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4318
# Comma-separated key=value pairs, e.g. Authorization=Basic <b64>. Leave empty when using the local collector.
EZBOT_OBSERVABILITY__OTLP_HEADERS=
