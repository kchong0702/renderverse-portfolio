{
  "name": "folio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/folio/src",
  "tags": ["type:app", "scope:backend"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "uv run python -m src.main",
        "cwd": "apps/folio"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/folio"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format .",
        "cwd": "apps/folio"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "apps/folio"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/folio"
      }
    }
  }
}
