# Shared infrastructure for every app (root docker-compose.yaml).
# App-specific settings live in each app's own .env.

# ---------------- COLLECTOR HOST PORTS ------------------
# Change these when another collector already holds the defaults,
# and point EZBOT_OBSERVABILITY__OTLP_ENDPOINT in apps/ezbot-harness/.env at the new HTTP port.
COLLECTOR_OTLP_GRPC_HOST_PORT=4317
COLLECTOR_OTLP_HTTP_HOST_PORT=4318
COLLECTOR_HEALTH_CHECK_HOST_PORT=13133
COLLECTOR_ZPAGES_HOST_PORT=55679
COLLECTOR_SELF_METRICS_HOST_PORT=8888

# ---------------- COLLECTOR ------------------
DEPLOYMENT_ENV=dev

COLLECTOR_HEALTH_CHECK_ENDPOINT=0.0.0.0:13133
COLLECTOR_PPROF_ENDPOINT=0.0.0.0:1777
COLLECTOR_ZPAGES_ENDPOINT=0.0.0.0:55679

COLLECTOR_OTLP_GRPC_ENDPOINT=0.0.0.0:4317
COLLECTOR_OTLP_MAX_RECV_MSG_SIZE_MIB=32
COLLECTOR_OTLP_HTTP_ENDPOINT=0.0.0.0:4318

COLLECTOR_PROCESSORS_MEMORY_LIMITER_CHECK_INTERVAL=2s
COLLECTOR_PROCESSORS_MEMORY_LIMITER_LIMIT_PERCENTAGE=80
COLLECTOR_PROCESSORS_MEMORY_LIMITER_SPIKE_LIMIT_PERCENTAGE=25

COLLECTOR_PROCESSORS_RESOURCE_DETECTION_TIMEOUT=2s
COLLECTOR_PROCESSORS_RESOURCE_DETECTION_OVERRIDE=false

COLLECTOR_PROCESSORS_BATCH_TIMEOUT=5s
COLLECTOR_PROCESSORS_SEND_BATCH_SIZE=1024
COLLECTOR_PROCESSORS_SEND_BATCH_MAX_SIZE=2048

# basic: counts only, detailed: full span / metric dump to collector logs
COLLECTOR_EXPORTERS_DEBUG_VERBOSITY=basic

COLLECTOR_SERVICE_TELEMETRY_LOGS_LEVEL=info
COLLECTOR_SERVICE_METRICS_LEVEL=detailed
COLLECTOR_SERVICE_METRICS_ADDRESS=0.0.0.0:8888
